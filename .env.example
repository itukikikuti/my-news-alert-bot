RSS_URLS=https://www.google.co.jp/alerts/feeds/xxxxx/yyyyy
# GUI_PORT=3334

# Discord notification via Incoming Webhook (required for notifications).
# Create one in Discord: Channel Settings → Integrations → Webhooks → New Webhook.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/yyyyy

# Ollama Cloud API key for AI notification filtering.
# When set, each feed's prompt decides whether an article is notified.
# Get a key at https://ollama.com/settings/keys
# OLLAMA_API_KEY=
# OLLAMA_MODEL=gpt-oss:20b

# Iris work-session notification judge (auth token is optional; never log it).
# IRIS_TOKEN=
# IRIS_URL=http://10.0.0.99:3170
# AI_FILTER_MODE=iris # gpt-oss, iris, or hybrid (iris recommended)
# IRIS_MODEL_ID=codex # optional; model for a newly created judge session (default: iris work default)
# IRIS_BATCH_SIZE=5 # articles per judgment message (title + URL only; 1-9)
# IRIS_SUBAGENT_MODEL= # Agent model for opening articles; default: haiku on Claude sessions,
#                      # inherit the session model on Ollama sessions ("inherit" forces that)
